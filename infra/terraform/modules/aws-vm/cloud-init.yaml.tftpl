#cloud-config
# First-boot setup for the Gravita homologation VM (Ubuntu 24.04, ARM / Graviton).
package_update: true
package_upgrade: true

packages:
  - docker.io
  - docker-compose-v2
  - fail2ban
  - unattended-upgrades
  - cron
  - rsync

users:
  - default
  - name: ${deploy_user}
    groups: [docker]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
%{ if length(ssh_public_keys) > 0 ~}
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}
%{ endif ~}

write_files:
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "5" }
      }
  - path: /etc/cron.d/gravita-backup
    content: |
      # Nightly database backup at 03:00 UTC (the script lands with the first deploy).
      0 3 * * * ${deploy_user} [ -x /opt/gravita/scripts/backup.sh ] && /opt/gravita/scripts/backup.sh >> /var/log/gravita-backup.log 2>&1

runcmd:
  # Swap as a safety net on small instances.
  - fallocate -l ${swap_gbs}G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - touch /var/log/gravita-backup.log && chown ${deploy_user}:${deploy_user} /var/log/gravita-backup.log
  - mkdir -p /opt/gravita /var/backups/gravita
  - chown -R ${deploy_user}:${deploy_user} /opt/gravita /var/backups/gravita
  - systemctl enable --now docker fail2ban
  - systemctl restart docker
  - systemctl restart ssh
