# Template for infra/secrets/homolog.env. Fill in, then encrypt before committing:
#   cp secrets/homolog.env.example secrets/homolog.env
#   sops --encrypt --in-place secrets/homolog.env
# Values containing `$` (bcrypt hashes) must be single-quoted.

# --- Compose / Caddy ---------------------------------------------------------
APP_IMAGE=ghcr.io/<org>/gravita:<git-sha>
HOMOLOG_DOMAIN=homolog.example.com
MAIL_DOMAIN=mail.homolog.example.com
ACME_EMAIL=ops@example.com
BASIC_AUTH_USER=gravita
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
BASIC_AUTH_HASH='$2a$14$replace-me'

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=gravita
POSTGRES_USER=gravita
POSTGRES_PASSWORD=change-me

# --- AWS SQS (values from `terraform output`) ---------------------------------
# No access keys: the app authenticates with the EC2 instance role.
AWS_REGION=us-east-1
AWS_SQS_EMAIL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account>/homolog-gravita-email-notifications
AWS_SQS_WHATSAPP_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account>/homolog-gravita-quote-whatsapp
SQS_USER_REGISTRATION_QUEUE_NAME=homolog-user_registration_queue
SQS_PASSWORD_RESET_QUEUE_NAME=homolog-password_reset_queue

# --- App secrets (generate new ones; never reuse the local profile's) --------
# openssl rand -base64 32
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-me
CERTIFICATE_ENCRYPTION_KEY=replace-me
PDV_SUPERVISOR_PASSWORD_HASH='$2a$10$replace-me'

# --- Links and notification recipients ---------------------------------------
APP_MAIL_SENDER=no-reply@homolog.example.com
ACTIVATION_LINK_BASE_URL=https://homolog.example.com/api/activate
ACTIVATION_RESULT_PAGE_URL=https://homolog.example.com/activate.html
PASSWORD_RESET_LINK_BASE_URL=https://homolog.example.com/reset-password
PURCHASING_APPROVER_EMAIL=purchasing@homolog.example.com
INVENTORY_EXPIRING_LOTS_EMAIL=inventory@homolog.example.com
CRM_FOLLOW_UP_EMAIL=crm@homolog.example.com
FINANCE_CASH_FLOW_ALERT_EMAIL=finance@homolog.example.com

# --- Backups (S3, via the instance role; retention is an S3 lifecycle rule) --
BACKUP_BUCKET=gravita-homolog-backups-<account-id>